# ─────────────────────────────────────────────────────────────
# CADENCE environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase (auth, Postgres, storage, sync). Leave empty to run in device-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used by the reminder cron to read journals across users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server only) — powers screenshot analysis, trade reviews and the performance coach.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
CADENCE_AI_MODEL=
# Device-only mode has no user accounts. Set to "true" ONLY for a private, single-user deployment
# to allow AI calls without a Supabase login. Leave unset on any public URL.
CADENCE_AI_ALLOW_ANONYMOUS=

# Web Push (evening reminders). Generate with `npm run vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
